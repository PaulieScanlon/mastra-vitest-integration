{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@mastra/evals/vitest"],
    "noEmit": true,
    "outDir": "dist"
  },
  "include": ["src/**/*", "evals/**/*", "vitest.config.ts"]
}
